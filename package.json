{
  "name": "distributed-wagering-processor",
  "version": "0.1.0",
  "description": "Processador distribuído de transações de aposta com correção financeira sob entrega at-least-once",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "test": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "test:concurrency": "bun test tests/concurrency",
    "test:load": "k6 run load/wagering.js",
    "migration:generate": "bun run node_modules/.bin/typeorm migration:generate -d src/infrastructure/persistence/data-source.ts",
    "migration:run": "bun run scripts/migration-run.ts",
    "migration:revert": "bun run scripts/migration-revert.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "@types/express": "^5.0.6",
    "eslint": "^10.8.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "trustedDependencies": [
    "unrs-resolver"
  ],
  "dependencies": {
    "@nestjs/common": "^11.1.29",
    "@nestjs/core": "^11.1.29",
    "@nestjs/platform-express": "^11.1.29",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "decimal.js": "^10.6.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.0"
  }
}
